<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.stream.processing</groupId>
        <artifactId>stream-processing</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>common-model</artifactId>
    <name>Common Model</name>
    <description>Event contract shared by the ingest service, the Flink pipeline and the alert service.</description>

    <properties>
        <!--
            Targets Java 17, not 21. This module is loaded inside the Flink TaskManager, whose
            image for the 1.20 LTS line tops out at Java 17; a Java 21 class file would fail to
            load there with UnsupportedClassVersionError. The Java 21 services consume a
            17-targeted jar without issue, so the constraint costs nothing.
        -->
        <maven.compiler.release>${flink.compiler.release}</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
    </dependencies>
</project>
