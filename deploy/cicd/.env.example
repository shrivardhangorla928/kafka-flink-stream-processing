# Copy to .env and edit. .env is gitignored - it holds a real SonarQube token.
#
#   cp .env.example .env
#
# SONAR_TOKEN starts empty on purpose: SonarQube has to be running before a token
# can exist. sonarqube/bootstrap.sh creates one and writes it back into .env, so the
# order is:
#
#   docker compose up -d sonar-db sonarqube
#   ./sonarqube/bootstrap.sh
#   docker compose up -d --build jenkins

# --- Jenkins -----------------------------------------------------------------
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# --- SonarQube ---------------------------------------------------------------
SONAR_DB_PASSWORD=change-me
# bootstrap.sh rotates the shipped admin/admin to this value on first run, then
# authenticates with it on every later run. SonarQube enforces a password policy and
# rejects anything without a special character, so a plain alphanumeric string will
# fail with HTTP 400 - include a symbol.
SONAR_ADMIN_PASSWORD=change-me
# Filled in by sonarqube/bootstrap.sh
SONAR_TOKEN=

# --- The repository the pipeline builds --------------------------------------
GIT_REPO_URL=https://github.com/shrivardhangorla928/kafka-flink-stream-processing.git
GIT_BRANCH=*/develop
